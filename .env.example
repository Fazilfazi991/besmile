# Public browser configuration. Values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=https://crm.example.com

# Server-only configuration. Never use a NEXT_PUBLIC_ prefix for these values.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Browser Push (VAPID). The public key is safe for the browser; keep the
# private key server-only and configure all three values in Vercel.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-vapid-public-key
WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-server-only-vapid-private-key
WEB_PUSH_CONTACT_EMAIL=admin@your-approved-bsmile-domain.example
# Shared only with the Supabase Database Webhook that forwards notification
# INSERT events to /api/push/dispatch. Never expose this value in the browser.
PUSH_DISPATCH_SECRET=replace-with-a-long-random-secret

# Optional: only enable a monitoring integration after it is configured.
# SENTRY_DSN=

# Customer Feedback Google Sheets integration. Share the response sheet with
# GOOGLE_SERVICE_ACCOUNT_EMAIL as Viewer; do not expose these values to clients.
GOOGLE_FEEDBACK_SPREADSHEET_ID=
GOOGLE_FEEDBACK_SHEET_NAME=Form_Responses
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional JSON object overriding semantic fields to exact Sheet headings.
# GOOGLE_FEEDBACK_COLUMN_MAP={"timestamp":"Timestamp","customerName":"Your Name"}

# Development/QA only. Never set these in Vercel production.
# QA_SEED_PASSWORD=
# SEED_USER_TEMP_PASSWORD=
# ALLOW_QA_SEED=false
