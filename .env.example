# Public browser configuration. Values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_APP_URL=https://crm.example.com

# Server-only configuration. Never use a NEXT_PUBLIC_ prefix for these values.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Optional: only enable a monitoring integration after it is configured.
# SENTRY_DSN=

# Development/QA only. Never set these in Vercel production.
# QA_SEED_PASSWORD=
# SEED_USER_TEMP_PASSWORD=
# ALLOW_QA_SEED=false
